% ---------------------------------------------------------------
% references.bib
%
% Populate this from a BibTeX export of the Zotero/Mendeley library
% rather than by hand. Zotero: right-click the collection, then
% Export Collection, format BibTeX, and overwrite this file.
%
% House rules carried over from the literature tables:
%   * original journal research articles, 2021 or later
%   * reviews ARE allowed here, unlike in the literature sheet
%   * every DOI verified against the publisher record before it is
%     cited; the screening worklist entries are not yet verified
%
% WARNING: the percent sign is not a comment character to BibTeX.
% An entry marker is parsed even on a "commented" line, so never
% put an example entry in a comment -- put it in a comment block.
% ---------------------------------------------------------------

@comment{
  Expected field set:

  article{key2024,
    author  = {Surname, First and Surname, First},
    title   = {Title of the paper},
    journal = {Journal Name},
    year    = {2024},
    volume  = {12},
    number  = {3},
    pages   = {123--145},
    doi     = {10.xxxx/yyyyy},
  }
}

