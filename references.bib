   publisher = {Springer Science and Business Media LLC},
   title = {The cost of corrosion in China},
   volume = {1},
   year = {2017}
}

@article{Jiang2023,
   abstract = {To detect corrosion-related damages inside dim steel box girders, an improved U-net, Fusion-Attention-U-net (FAU-net), is proposed in this paper. A database of 300 damage images is built after data augmentation. The network achieves 98.61% pixel accuracy, 92.73% mean pixel accuracy, 77.57% mean intersection over union and 97.52% frequency weighted intersection over union on the validation set. To establish the relationship between the detected damage pixel area and its actual physical area, photography experiments and theoretical analyses are conducted to study the effect of three critical shooting variables: shooting distance, focal length and shooting angle. A theoretical equation linking the pixel and physical areas is derived and validated using field-taken damage images under different shooting cases.},
   author = {Fei Jiang and Youliang Ding and Yongsheng Song and Fangfang Geng and Zhiwen Wang},
   doi = {10.1007/s13349-022-00631-y},
   journal = {Journal of Civil Structural Health Monitoring},
   number = {1},
   pages = {199-217},
   publisher = {Springer Science and Business Media LLC},
   title = {Automatic pixel-level detection and measurement of corrosion-related damages in dim steel box girders using Fusion-Attention-U-net},
   volume = {13},
   year = {2023}
}

@article{Maharjan2025,
   abstract = {Corrosion detection in steel headrace tunnels is hampered by constrained access windows and suboptimal inspection conditions including poor lighting and high humidity. This study proposes a domain-adaptive self-supervised learning framework for corrosion segmentation and maps the result onto a 3D building information model. The authors note that deep learning performance is highly sensitive to input image quality, and that adverse environmental conditions such as poor lighting, occlusions, wet surfaces or structural clutter obscure damage features and reduce model accuracy.},
   author = {Shreejan Maharjan and Shogo Inadomi and Kenta Itakura and {Pang-jo} Chun},
   doi = {10.1111/mice.70077},
   journal = {Computer-Aided Civil and Infrastructure Engineering},
   number = {},
   pages = {4425-4447},
   publisher = {Wiley},
   title = {Domain-adaptive self-supervised learning for corrosion detection and 3D building information model mapping in steel tunnels},
   volume = {40},
   year = {2025}
}

