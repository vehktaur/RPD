@article{Hou2017,
   abstract = {The present study summarises the findings that arose from the landmark "Study of Corrosion Status and Control Strategies in China", a key consulting project of the Chinese Academy of Engineering in 2015, which sought to determine the national cost of corrosion and costs associated with representative industries in China. The study estimated that the cost of corrosion in China was approximately 2127.8 billion RMB (~310 billion USD), representing about 3.34% of the gross domestic product.},
