@article{Zhang2026e,
   abstract = {Boilers, as core and critical equipment in energy, chemical, and other fields, have water-cooled wall tubes that operate under harsh conditions of high temperature, high pressure, and corrosive media for extended periods. These tubes are prone to corrosion failure, directly threatening equipment safety and causing significant economic losses. Current corrosion detection of boiler water-cooled wall tubes largely relies on manual visual inspection or traditional non-destructive testing methods, which suffer from low efficiency, high subjectivity, insufficient accuracy, and difficulty in adapting to large-scale testing needs. To address these challenges, this paper proposes a precise corrosion image detection scheme based on computer vision big data algorithms, constructing a complete technical system encompassing "data acquisition and preprocessing - feature extraction and fusion - corrosion identification and quantification." First, a multi-source image acquisition platform is built to obtain a large-scale dataset of water-cooled wall tube corrosion images, and data augmentation and denoising algorithms are used to improve data quality. Second, an improved convolutional neural network and attention mechanism are integrated to construct a feature extraction model, achieving accurate capture of deep semantic features and local detail features of the corrosion area. Finally, a multi-scale corrosion quantification assessment module is designed to complete corrosion level classification and damage degree quantification. Experimental results show that the proposed computer vision big data algorithm achieves the highest detection accuracy on both self-built datasets and publicly available industrial datasets, reaching 96.2% and 93.5% respectively. Compared with the ResNet-50 algorithm, the accuracy is improved by 10.4 percentage points and 12.3 percentage points respectively. It can effectively meet the needs of accurate detection of corrosion of boiler water-cooled wall tubes in industrial scenarios and provide reliable technical support for equipment life cycle management.},
   author = {Zijian Zhang and Zhaoqiang Luo and Junping Zhong and Lei Zheng and Junhui Chai},
   doi = {10.1016/j.procs.2026.04.209},
   issn = {18770509},
   journal = {Procedia Computer Science},
   pages = {207-215},
   title = {Application of Computer Vision Big Data Algorithms in Accurate Detection of Corrosion Images of Boiler Water-cooled Wall Tubes},
   volume = {281},
   url = {https://linkinghub.elsevier.com/retrieve/pii/S1877050926012226},
   year = {2026}
}
@article{Zhang2024,
   abstract = {Object detection is dedicated to finding objects in an image and estimate their categories and locations. Recently, object detection algorithms suffer from a loss of semantic information in the deeper feature maps due to the deepening of the backbone network. For example, when using complex backbone networks, existing feature fusion methods cannot fuse information from different layers effectively. In addition, anchor-free object detection methods fail to accurately predict the same object due to the different learning mechanisms of the regression and centrality of the prediction branches. To address the above problem, we propose a multi-scale fusion and interactive learning method for fully convolutional one-stage anchor-free object detection, called MFIL-FCOS. Specifically, we designed a multi-scale fusion module to address the problem of local semantic information loss in high-level feature maps which strengthen the ability of feature extraction by enhancing the local information of low-level features and fusing the rich semantic information of high-level features. Furthermore, we propose an interactive learning module to increase the interactivity and more accurate predictions by generating a centrality-position weight adjustment regression task and a centrality prediction task. Following these strategic improvements, we conduct extensive experiments on the COCO and DIOR datasets, demonstrating its superior capabilities in 2D object detection tasks and remote sensing image detection, even under challenging conditions.},
   author = {Guoqing Zhang and Wenyu Yu and Ruixia Hou},
   doi = {10.3390/rs16060936},
   issn = {20724292},
   number = {6},
   journal = {Remote Sensing},
   keywords = {interactive learning,multi-scale feature fusion,object detection,remote sensing image detection},
   month = {3},
   publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
   title = {MFIL-FCOS: A Multi-Scale Fusion and Interactive Learning Method for 2D Object Detection and Remote Sensing Image Detection},
   volume = {16},
   year = {2024}
}
@article{Sun2023,
   abstract = {Due to the challenges of small detection targets, dense target distribution, and complex backgrounds in aerial images, existing object detection algorithms perform poorly in aerial image detection tasks. To address these issues, this paper proposes an improved algorithm called YOLOv5s-DSD based on YOLOv5s. Specifically, the SPDA-C3 structure is proposed and used to reduce information loss while focusing on useful features, effectively tackling the challenges of small detection targets and complex backgrounds. The novel decoupled head structure, Res-DHead, is introduced, along with an additional small object detection head, further improving the network's performance in detecting small objects. The original NMS is replaced by Soft-NMS-CIOU to address the issue of neighboring box suppression caused by dense object distribution. Finally, extensive ablation experiments and comparative tests are conducted on the VisDrone2019 dataset, and the results demonstrate that YOLOv5s-DSD outperforms current state-of-the-art object detection models in aerial image detection tasks. The proposed improved algorithm achieves a significant improvement compared with the original algorithm, with an increase of 17.4% in mAP@0.5 and 16.4% in mAP@0.5:0.95, validating the superiority of the proposed improvements.},
   author = {Chaoyue Sun and Yajun Chen and Ci Xiao and Longxiang You and Rongzhen Li},
   doi = {10.3390/s23156905},
   issn = {14248220},
   number = {15},
   journal = {Sensors},
   keywords = {YOLOv5,aerial imagery,dense small objects,object detection},
   month = {8},
   pmid = {37571688},
   publisher = {Multidisciplinary Digital Publishing Institute (MDPI)},
   title = {YOLOv5s-DSD: An Improved Aerial Image Detection Algorithm Based on YOLOv5s},
   volume = {23},
   year = {2023}
}
@article{Wu2023,
   abstract = {With fast increase in volume of mobile multimedia data, how to apply powerful deep learning methods to process data with real-time response becomes a major issue. Meanwhile, edge computing structure helps improve response time and user experience by bringing flexible computation and storage capabilities. Considering both technologies for successful AI-based applications, we propose an edge-computing driven and end-to-end framework to perform tasks of image enhancement and object detection under low-light conditions. The framework consists of a cloud-based enhancement and an edge-based detection stage. In the first stage, we establish connections between edge devices and cloud servers to input re-scaled illumination parts of low-light images, where enhancement subnetworks are dynamically and parallel coupled to compute enhanced illumination parts based on low-light context. During the edge-based detection stage, edge devices could accurately and rapidly detect objects based on cloud-computed informative feature map. Experimental results show the proposed method significantly improves detection performance in low-light conditions with low latency running on edge devices.},
   author = {Yirui Wu and Haifeng Guo and Chinmay Chakraborty and Mohammad R. Khosravi and Stefano Berretti and Shaohua Wan},
   doi = {10.1109/TNSE.2022.3151502},
   issn = {23274697},
   number = {5},
   journal = {IEEE Transactions on Network Science and Engineering},
   keywords = {Low-light image enhancement,edge-driven deep learning method.,object detection},
   month = {9},
   pages = {3086-3098},
   publisher = {IEEE Computer Society},
   title = {Edge Computing Driven Low-Light Image Dynamic Enhancement for Object Detection},
   volume = {10},
   year = {2023}
}
@inproceedings{Cheng2024,
   abstract = {To achieve corrosion detection of hydraulic metal structures based on deep learning, reduce subjectivity in the corrosion annotation process, and enhance annotation efficiency, this study proposes a corrosion detection method for hydraulic metal structures based on a YOLOv10 serial architecture that incorporates a Transformer module. The serial architecture first uses an object detection model to locate corrosion, followed by a classification model to assess corrosion severity. In terms of F1-score, the proposed corrosion detection network shows a 1% improvement over the baseline. For accuracy, after transfer learning, the proposed corrosion classification model outperforms the baseline by 8.8%. This method was implemented in real-world scenarios, successfully enabling corrosion detection and severity classification of hydraulic metal structures, and verifying the feasibility of the serial architecture.},
   author = {Haodong Cheng and Fei Kang and Sisi Zhu},
   doi = {10.1109/ICARCE63054.2024.00047},
   isbn = {9798331529505},
   booktitle = {Proceedings - 2024 3rd International Conference on Automation, Robotics and Computer Engineering, ICARCE 2024},
   keywords = {corrosion detection,deep learning,hydraulic metal structures,vision inspection},
   pages = {217-221},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {A Corrosion Detection Method for Hydraulic Metal Structures Based on an Improved YOLOv10 Model},
   year = {2024}
}
@inproceedings{Sahana2024,
   abstract = {Corrosion presents a major risk to the structural integrity and longevity of steel bridges, necessitating effective monitoring and assessment. Unchecked corrosion can compromise structural stability and incur substantial economic and environmental costs. This research introduces a novel approach for assessing corrosion in steel bridges using deep learning-based image segmentation. Utilizing a dataset of 514 RGB images from steel bridge elements, captured by drones and Nikon cameras, and annotated at the pixel level, we evaluated various deep learning architectures. A total of 412 images were used for training, 90 for validation, and 12 for testing from the dataset. Initial experiments with U-Net, SegNet, FPN, BiSeNet, and EncNet showed promising results, with the FPN model achieving an accuracy of 86%, F1 score of 0.79, IOU of 0.65, and mAP of 0.88. Enhanced performance was achieved by incorporating VGG16 and ResNet50 backbones into the FPN model, resulting in an accuracy of 95.75%, F1 score of 0.93, IOU of 0.88, and mAP of 0.89. These findings illustrate how transfer learning enhances accuracy and reliability of deep learning-based segmentation models for corrosion assessment in steel bridge inspections.},
   author = {S. Sahana and P. Chitra},
   doi = {10.1109/GCAT62922.2024.10924123},
   isbn = {9798350376685},
   booktitle = {2024 5th IEEE Global Conference for Advancement in Technology, GCAT 2024},
   keywords = {Deep learning,backbone architectures,corrosion assessment,dataset annotation,drone imagery,image segmentation,steel bridges,transfer learning},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Advancing Infrastructure Integrity: Deep Learning Based Segmentation for Steel Bridge Corrosion Assessment},
   year = {2024}
}
@article{Sun2026,
   abstract = {Recently, although fully-supervised salient object detection in optical remote sensing images (ORSI-SOD) has achieved remarkable performance improvements, the pixel-level annotations required by such supervision paradigm are extremely labor-intensive and resource-consuming. To alleviate this issue, weakly-supervised ORSI-SOD methods, especially those based on scribble annotations, have made considerable progress. Unfortunately, prevailing weakly-supervised ORSI-SOD methods lack explicit modeling of multi-directional features for salient objects, and neglect the effective utilization of edge information, particularly the cross-scale exchange of edge knowledge. To overcome these limitations, we present MNEFNet, a weakly-supervised salient object detection network based on multi-directional nesting and edge scan fusion. The model integrates two key modules: the Multi-directional Nested Mamba Module (MNMM) and the Cross-scale Edge Scanning Fusion Module (CESFM). MNMM adopts a bi-level nested architecture inspired by Vision Mamba, consisting of weight simulation generation and state equivalent update in the outer path, as well as explicit directional encoding and internal Mamba units in the inner path. It enables the network to estimate saliency by capturing and reasoning directional characteristics of objects without pixel-level supervision. As for the CESFM, its core objective is to enhance the localization of salient objects and refine their boundaries. This module mainly contains an edge information cache and a cross-scale Mamba fusion component. Through the joint operation of these two parts, the hidden edge cues at multiple levels and scales can be stored, mined, aggregated and utilized efficiently and accurately. Extensive experiments on benchmark datasets demonstrate that the proposed MNEFNet achieves state-of-the-art SOD performance.},
   author = {Mingsi Sun and Lelei Yan and Yi Gu and Pingping Liu},
   doi = {10.1016/j.neucom.2026.134537},
   issn = {18728286},
   journal = {Neurocomputing},
   keywords = {Cross-scale edge scanning fusion,Multi-directional nested mamba,Optical remote sensing images,Scribble annotation,Weakly salient object detection},
   month = {11},
   publisher = {Elsevier B.V.},
   title = {Weakly supervised salient object detection in optical remote sensing images based on multi-directional nesting and edge scan fusion},
   volume = {701},
   year = {2026}
}
@article{Huang2022,
   abstract = {Metal corrosion in high-risk areas, such as high-altitude cables and chemical factories, is very complex and inaccessible to people, which can be a hazard and compromise people's safety. Embedding deep learning models into edge computing devices is urgently needed to conduct corrosion inspections. However, the parameters of current state-of-the-art models are too large to meet the computation and storage requirements of mobile devices, while lightweight models perform poorly in complex corrosion environments. To address these issues, a lightweight residual deep-learning model based on an encoder--decoder structure is proposed in this paper. We designed small and large kernels to extract local detailed information and capture distant dependencies at all stages of the encoder. A sequential operation consisting of a channel split, depthwise separable convolution, and channel shuffling were implemented to reduce the size of the model. We proposed a simple, efficient decoder structure by fusing multi-scale features to augment feature representation. In extensive experiments, our proposed model, with only 2.41 MB of parameters, demonstrated superior performance over state-of-the-art segmentation methods: 75.64% mean intersection over union (IoU), 86.07% mean pixel accuracy and a 0.838 F1-score. Moreover, a larger version was designed by increasing the number of output channels, and model accuracy improved further: 79.06% mean IoU, 88.07% mean pixel accuracy, and 0.891 F1-score. The size of the model remained competitive at 8.25 MB. Comparison work with other networks and visualized results were used for validation and to determine the accuracy of metal corrosion surface segmentation with limited resources.},
   author = {Jingxu Huang and Qiong Liu and Lang Xiang and Guangrui Li and Yiqing Zhang and Wenbai Chen},
   doi = {10.3390/app12189095},
   issn = {20763417},
   number = {18},
   journal = {Applied Sciences (Switzerland)},
   keywords = {contextual feature,corrosion segmentation,large convolution kernels,lightweight residual model},
   month = {9},
   publisher = {MDPI},
   title = {A Lightweight Residual Model for Corrosion Segmentation with Local Contextual Information},
   volume = {12},
   year = {2022}
}
@article{Ahuja2021,
   abstract = {Pitting corrosion detection is getting huge attention due to its ability to enable an effective diagnosing mechanism. Despite existing techniques trying to resolve issues in this area, it is not yet considered as effective in terms of results. Therefore, the development of an enhanced pitting corrosion diagnosing scheme that resolves the problems of the existing diagnosing system by enabling a novel approach is proposed. In this work, a deep learning strategy is adopted for effective prediction. The Residual U-Net is considered where the encoder and decoder execute the segmentation process. Then, the adaptation of the Bidirectional Conv-LSTM technique can provide better classification results by analyzing various images. Moreover, the size of the pitting corrosion is determined based on its bytes' values. Finally, the implementation of the proposed work is done on the platform of MATLAB. Performance analysis metrics such as accuracy, precision, specificity, sensitivity, and F-measure, etc. are considered, proving the obtained results are better than existing techniques. Therefore, the proposed technique can be considered an effective platform for corrosion detection with enhanced modeling.},
   author = {Sanjay Kumar Ahuja and Manoj Kumar Shukla and Kiran Kumar Ravulakollu},
   doi = {10.23940/ijpe.21.07.p7.627637},
   issn = {29938341},
   number = {7},
   journal = {International Journal of Performability Engineering},
   keywords = {Corrosion,Deep learning,Image segmentation,Machine learning,Pitting corrosion},
   month = {7},
   pages = {627-637},
   publisher = {Totem Publishers Ltd},
   title = {Optimized deep learning framework for detecting pitting corrosion based on image segmentation},
   volume = {17},
   year = {2021}
}
@article{Wang2026c,
   abstract = {Corrosion detection plays a critical role in assessing material degradation and predicting performance changes to ensure equipment safety. Traditional manual inspection methods are highly subjective, while instrumental analysis tends to be destructive and costly. To address these limitations, this study proposes a machine vision-based method for detecting and predicting the composition of corrosion products on carbon steel subjected to corrosion after different durations. The corrosion products were analyzed using Raman spectroscopy. A generative adversarial network (GAN) was employed to expand the corrosion image dataset, and a convolutional neural network (CNN) was used for automatic corrosion classification. The K-means algorithm was then applied to segment different corrosion product regions. The total proportion of each corrosion product on the carbon steel surface was calculated by correlating the rusted area with the product distribution, and the corrosion evolution was analyzed using interpolation. Experimental results confirm that this method accurately quantifies corrosion product proportions, offering a novel strategy for intelligent corrosion detection.},
   author = {Qiuji Wang and Dequan Wu and Kun Zhou and Haiyan Gong and Suyu Jin and Jinke Wang and Zhibin Chen and Lingwei Ma and Dawei Zhang},
   doi = {10.1038/s41529-025-00729-w},
   issn = {23972106},
   number = {1},
   journal = {npj Materials Degradation},
   month = {12},
   publisher = {Nature Publishing Group},
   title = {Quantification and prediction of carbon steel surface corrosion based on machine vision},
   volume = {10},
   year = {2026}
}
@article{Fu2026,
   abstract = {As a burgeoning theme in optical remote sensing image (ORSI) analysis, salient object detection (SOD) plays a vital role in traffic monitoring, agriculture, disaster management, and other fields. However, the existing ORSI-SOD methods are all single-modal (RGB images primarily), which suffer from performance drop when facing complex scenes (e.g., intricate backgrounds, low contrast scenes, and similar objects). To address this challenge, we introduce estimated depth map to complement RGB image in ORSI-SOD for the first time, which provides 3D geometric cues to improve detection accuracy in complex scenes, thus advancing ORSI-SOD from single-modal to multi-modal. Furthermore, we design a novel pretraining framework: multi-modal reconstructed image pretraining (MMRIP) to pretrain SOD model in multi-modal ORSI-SOD. MMRIP initially utilizes a masked autoencoder (MAE) to restore the masked RGB image; subsequently, it feeds the restored RGB image and clean depth map to the SOD model to generate the saliency map, which can help SOD model more effectively integrate cross modal information and extract better feature. Besides, we present a simple RGB-D SOD model, namely SimSOD, which is pretrained by MMRIP for ORSI-SOD. SimSOD has two major components: DFormer (encoder) and MLP head (decoder). Specifically, we first input RGB image and depth data into the encoder to generate four multi-scale features, then use the decoder to fuse these features and yield the prediction result. Without bells and whistles, our proposed method outperforms the state-of-the-art methods on three public ORSI-SOD datasets. The code can be accessed at: https://github.com/Voruarn/MMRIP.},
   author = {Yuxiang Fu and Wei Fang},
   doi = {10.1016/j.eswa.2025.129624},
   issn = {09574174},
   journal = {Expert Systems with Applications},
   keywords = {Multi-modal,Pattern recognition,Remote sensing image,Salient object detection},
   month = {3},
   publisher = {Elsevier Ltd},
   title = {Incorporating estimated depth maps and multi-modal pretraining to improve salient object detection in optical remote sensing images},
   volume = {298},
   year = {2026}
}
@article{Batchuluun2021,
   abstract = {Recently, thermal cameras are being widely used in various fields, such as intelligent surveillance, biometrics, and health monitoring. However, the high cost of the thermal cameras poses a challenge in terms of purchase. Additionally, thermal images have an issue pertaining to blurring caused by object movement, camera movement, and camera focus settings. There have been very few studies on image restoration centered around thermal images to address such problems. Moreover, it is important to increase the processing speed of image restoration methods to jointly conduct with methods such as action recognition and object tracking that use temporal information from thermal videos. However, no study has been conducted on simultaneously performing super-resolution reconstruction and deblurring using thermal images. Furthermore, existing studies on object detection using thermal images have errors owing to the incapability in distinguishing reflections on the surrounding ground or wall due to the heat radiated from the object. To address such issues, this study proposes a deep learning-based thermal image restoration method that simultaneously performs super-resolution reconstruction and deblurring. According to recent development of deep learning, generative adversarial network (GAN)-based methods which have ability to preserve texture details in images, and yield sharper and more plausible textures than classical feed forward encoders show success in image-to-image translation tasks. Considering the advantages of GAN, we propose a deblur-SRRGAN for thermal image reconstruction. In addition, we propose a light-weighted Mask R-CNN for object detection in the reconstructed thermal image. For the input, we employ an image processing method that converts 1-channel thermal images (often used in the existing studies) into 3-channel images. The results of the experiments conducted using self-collected databases and an open database demonstrate that our method outperforms the state-of-the-art methods.},
   author = {Ganbayar Batchuluun and Jin Kyu Kang and Dat Tien Nguyen and Tuyen Danh Pham and Muhammad Arsalan and Kang Ryoung Park},
   doi = {10.1109/ACCESS.2020.3048437},
   issn = {21693536},
   journal = {IEEE Access},
   keywords = {Thermal image,deep learning,image deblurring,object and thermal reflection detection,super-resolution reconstruction},
   pages = {5951-5971},
   publisher = {Institute of Electrical and Electronics Engineers Inc.},
   title = {Deep Learning-Based Thermal Image Reconstruction and Object Detection},
   volume = {9},
   year = {2021}
}
@techReport{Ken2024,
   abstract = {Corrosion, a global phenomenon causing irreversible damage to metals by chemical and electrochemical reactions, underscores their vulnerability to diverse mechanisms and factors. Hence, manufacturers must strike a balance between cost-effective production and ensuring optimal corrosion resistance, considering specific usage environments, and without compromising industry standards. This review briefly explores various factors and types of metallic corrosion. Additionally, it delves into multiple strategies aimed at preventing and mitigating the occurrence of the phenomenon.},
   author = {Jeffrey Ken and B Balangao},
   number = {1},
   journal = {Journal of Chemical Health Risks www.jchr.org JCHR},
   keywords = {Metals,corrosion,factors,prevention,types},
   pages = {79},
   title = {Corrosion of Metals: Factors, Types and Prevention Strategies},
   volume = {14},
   url = {www.jchr.org},
   year = {2024}
}
@article{Wang2026d,
   abstract = {There are significant challenges of salient object detection in optical remote sensing images, such as drastic variations in object scales, uneven spatial distributions, and complex background interference. This makes it difficult for existing models to strike a balance between global context and local details. To address these issues, we propose a novel network model based on attention interaction and multiple residual integration (AIMRINet). Firstly, the Pyramid Vision Transformer is adopted as the backbone network to extract global features at different scales. Secondly, a spatial attention interaction module is designed to operate on both shallow and deep features, which delivers spatial attention information from different layers to enhance the perception of spatial details and highlight salient objects. Moreover, a multi-residual feature integration module is designed to extract shared saliency information from different layers and preserve the local details and semantic information through multiple residual connections. The experimental results show that, compared with 18 methods, the proposed model achieves better detection performance on the ORSSD, EORSSD, and ORSI-4199 benchmark datasets and obtains an average improvement of 0.0002 in MAE, 0.31% in maxF, 0.15% in wfm and 0.04% in Sm.},
   author = {Yanzhao Wang and Jingbo Xia and Zhuying Chen and Tongchi Zhou and Zhongyun Liu and Li Yan},
   doi = {10.1016/j.imavis.2026.106117},
   issn = {02628856},
   journal = {Image and Vision Computing},
   keywords = {Multiple residual feature integration,Optical remote sensing images,Salient object detection,Spatial attention interaction},
   month = {10},
   publisher = {Elsevier Ltd},
   title = {Attention interaction and multiple residual integration network for salient object detection in remote sensing images},
   volume = {174},
   year = {2026}
}

